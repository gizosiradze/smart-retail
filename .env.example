# Copy to .env (production) and to .env.test (a separate free test project for localhost).
# Both are git-ignored: never commit them.

# --- Supabase project (Dashboard → Project Settings)
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Public key used by the web pages (API Keys → anon / publishable). Safe to expose.
SUPABASE_ANON_KEY=
# Secret keys: only for scripts on your computer / CI. Never in web/ or GitHub.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Personal access token for the Supabase CLI: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# --- Login tokens
# Must be the project's JWT secret: Project Settings → JWT Keys → "Legacy JWT secret".
# store-login signs the shop staff tokens with it; deploy.sh checks the project accepts them.
APP_JWT_SECRET=
# Site addresses allowed to call store-login (comma-separated). "*" only while testing.
# production: your site address(es); .env.test: http://localhost:5173
ALLOWED_ORIGINS=https://smart-retail.pages.dev

# --- Optional: publish web/ with "scripts/deploy.sh --web"
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=smart-retail

# --- Optional: Super Admin created by npm run dev:setup / npm run superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
